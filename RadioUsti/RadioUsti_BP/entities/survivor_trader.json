    },
    "component_groups": {
      "managed": {
        "minecraft:managed_wandering_trader": {}
      },
      "minecraft:scared": {
        "minecraft:angry": {
          "broadcastAnger": true,
          "broadcastRange": 10,
          "calm_event": {
            "event": "minecraft:become_calm",
            "target": "self"
          },
          "broadcast_filters": {
            "subject": "other",
            "test": "is_leashed_to",
            "value": true
          },
          "broadcast_targets": [
            "llama",
            "trader_llama"
          ],
          "duration": 5
        }
      }
